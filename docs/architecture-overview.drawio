    <mxCell id="channels_text" value="(1) claim MQTT, first boot only, 2 topics only&#10;(2) HTTPS greengrass:Discover, every boot&#10;(3) core's own persistent MQTT session (Nucleus,&#10;    jobs, shadow-for-connectivity-info, deployments)" style="text;html=1;fontSize=16;fontColor=#232F3E;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="shape_layer">
      <mxGeometry x="650" y="230" width="560" height="110" as="geometry" />
    </mxCell>

    <mxCell id="direct_note" value="(nothing else ever connects&#10;to the cloud MQTT endpoint)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=15;fontColor=#666666;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="shape_layer">
